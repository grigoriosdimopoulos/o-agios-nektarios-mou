rules_version = '2';

// Security model, in one line: this app runs entirely on the Spark (free) plan,
// so there is no server to own the counters — clients maintain them, and these
// rules are the only thing constraining what they may write.
//
// The consequences are deliberate and worth stating:
//
//   * A vote or comment tally can only move by one per write, and `score` must
//     stay equal to `upvotes - downvotes`. Someone running a modified client
//     could still nudge a counter without casting a real vote — rules cannot
//     see another document's pending write inside a transaction — but they
//     cannot jump a report to a thousand upvotes, and they cannot touch anyone
//     else's content. For a village of neighbours that is the right trade.
//   * Roles live on the user document rather than in a custom claim, because
//     setting a claim needs the Admin SDK. Only an administrator may write the
//     `role` and `disabled` fields, and never on their own document.
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Repeated get() calls to the same path inside one evaluation are cached,
    // so leaning on this helper does not multiply the read cost.
    function profile() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(uid()));
    }

    function isActiveResident() {
      return hasProfile() && profile().get('disabled', false) == false;
    }

    function role() {
      return hasProfile() ? profile().get('role', 'USER') : 'USER';
    }

    function isAdmin() {
      return isActiveResident() && role() == 'ADMIN';
    }

    function isModerator() {
      return isActiveResident() && (role() == 'ADMIN' || role() == 'MODERATOR');
    }

    /** Fields present in the incoming write that differ from the stored document. */
    function changed(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function touchesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    /**
     * Images live inside documents rather than in Cloud Storage, which needs a
     * billing account this village does not have. Firestore hard-caps a
     * document at 1 MiB, so every image field is bounded here as well as in the
     * app: a client is not the right place for the only copy of a limit.
     */
    function imageWithin(field, maxBytes) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is bytes
            && request.resource.data[field].size() <= maxBytes);
    }

    /** A counter that moved by at most one in either direction, and never below zero. */
    function movedByOne(field) {
      return request.resource.data[field] is int
        && request.resource.data[field] >= 0
        && request.resource.data[field] - resource.data[field] >= -1
        && request.resource.data[field] - resource.data[field] <= 1;
    }

    // ----------------------------------------------------------------- users

    match /users/{userId} {
      allow read: if isActiveResident() || uid() == userId;

      // Self-registration only, and never with a role of your own choosing.
      allow create: if isSignedIn()
        && uid() == userId
        && request.resource.data.get('role', 'USER') == 'USER'
        && request.resource.data.get('disabled', false) == false
        && profileFieldsOnly()
        && imageWithin('avatar', 30000);

      /**
       * Taking administrator rights by proving the passphrase.
       *
       * Narrow on purpose: only your own document, only the role field moving
       * to ADMIN, and only while an accepted claim exists — which it can only
       * do if the passphrase matched. `disabled` is untouchable here, so a
       * suspended resident cannot let themselves back in.
       */
      function isSelfElevation() {
        return isActiveResident()
          && uid() == userId
          && touchesOnly(['role', 'updatedAt'])
          && request.resource.data.role == 'ADMIN'
          && exists(/databases/$(database)/documents/adminClaims/$(uid()));
      }

      /**
       * Everything a profile document is allowed to contain.
       *
       * An allowlist, not a denylist, and that is the whole point. This
       * document is readable by every signed-in resident, so a field that
       * nobody thought about is a field the whole village can read. The house
       * pin used to live here and was exactly that: added for the ambulance,
       * legible to all forty-six phones, and permitted by a rule that only
       * knew how to say no to `role` and `disabled`. It now lives in
       * `private/home`, and this list is what stops the next such field from
       * being added without anyone noticing.
       *
       * The last seven are not written by any current version. They are kept
       * because documents created by earlier ones still carry them, and an
       * update sends the whole document — drop a legacy key from this list and
       * every resident who signed up before it was removed stops being able to
       * change their telephone number, add a device token, or be suspended by
       * an administrator. The three `home*` keys never reached a published
       * build, but a phone that ran a development build against the live
       * project has them, and permanently locking that account out of its own
       * profile is not a trade worth making for a field the app no longer
       * writes.
       */
      function profileFieldsOnly() {
        return request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'nameLower', 'email', 'phone', 'address',
          'blockId', 'avatar', 'role', 'disabled', 'fcmTokens',
          'notificationPrefs', 'createdAt', 'updatedAt',
          'photoUrl', 'issueCount', 'resolvedCount', 'upvotesReceived',
          'homeLat', 'homeLng', 'homePlace',
        ]);
      }

      // Residents edit their own contact details but never their own standing.
      // Administrators may edit anyone — including role and suspension — except
      // themselves, so the last admin cannot lock the village out by accident.
      allow update: if isSignedIn()
        && imageWithin('avatar', 30000)
        && profileFieldsOnly()
        && (
          (uid() == userId && !changed(['role', 'disabled', 'createdAt']))
          || (isAdmin() && uid() != userId && !changed(['createdAt']))
          || isSelfElevation()
        );

      // Residents may close their own account; administrators may remove a
      // resident. Neither can delete the underlying login — that needs the
      // Admin SDK — so the app deletes its own data and says so plainly.
      allow delete: if isSignedIn() && (uid() == userId || (isAdmin() && uid() != userId));

      // ---------------------------------------------------- notification inbox

      /**
       * One resident's notices, written *by other residents*.
       *
       * Sending a real push needs a server credential, which needs the paid
       * plan, so the acting client addresses the notice itself: comment on your
       * report and my phone writes a document here, under your uid, and your
       * phone turns it into a notification.
       *
       * That necessarily means any resident may write into anyone's inbox —
       * there is no way to notify someone without writing something they can
       * see. What is constrained is everything else: the notice must be
       * honestly attributed, it cannot arrive pre-read, and it is capped so an
       * inbox cannot be used to store bulk data at someone else's expense.
       * Reading and clearing stay private to the owner.
       */
      match /notifications/{noticeId} {
        allow read, update, delete: if isSignedIn() && uid() == userId;

        allow create: if isActiveResident()
          && request.resource.data.actorId == uid()
          && request.resource.data.get('seen', false) == false
          && request.resource.data.get('title', '').size() <= 200
          && request.resource.data.get('body', '').size() <= 500
          && request.resource.data.get('bodyArg', '').size() <= 500
          && request.resource.data.get('deepLink', '').size() <= 300;
      }

      // ------------------------------------------------------- the house pin

      /**
       * Documents about a resident that no other resident may read.
       *
       * At the moment there is exactly one, `private/home`, holding the
       * coordinates of the house. It is here rather than on the profile for a
       * single reason: the profile is readable by every signed-in resident,
       * and the screen that asks for the pin says it is so an ambulance can be
       * told where to come. Storing it on the profile would have made every
       * phone in the village able to read every household's exact position,
       * quietly, for a purpose nobody agreed to.
       *
       * Administrators are not exempt. There is nothing an administrator does
       * in this app that needs a neighbour's coordinates, and a rule that says
       * "only you" is worth more than one that says "only you, and whoever
       * holds the passphrase".
       */
      match /private/{document} {
        allow read, delete: if isSignedIn() && uid() == userId;

        allow write: if isSignedIn()
          && uid() == userId
          && document == 'home'
          && request.resource.data.lat is number
          && request.resource.data.lng is number
          && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
          && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
          && request.resource.data.get('place', '').size() <= 80
          && request.resource.data.keys().hasOnly(['lat', 'lng', 'place', 'updatedAt']);
      }
    }

    // ------------------------------------------------- administrator elevation

    /**
     * The village's admin passphrase, at `config/admin` with field `secret`.
     *
     * No client may read it. Rules may: a `get()` inside a rule is evaluated on
     * the server and is not itself subject to these rules, which is what makes
     * a secret usable without ever shipping it to a phone.
     *
     * Set it from the Firebase console. Until it exists, every elevation
     * attempt fails — which is the correct default for a village that has not
     * chosen a passphrase.
     */
    match /config/{document} {
      allow read, write: if false;
    }

    /**
     * Proof that somebody typed the passphrase.
     *
     * The write succeeds only if what they typed matches the stored secret, so
     * a wrong guess is rejected here and learns nothing: a wrong passphrase and
     * an unconfigured village fail identically. Nobody may read this collection
     * — including its own author — so the secret cannot be recovered from it.
     *
     * The app deletes the claim as soon as it has been used. Deletion is
     * allowed so it does not need administrator rights to clean up after
     * itself.
     */
    match /adminClaims/{userId} {
      allow read: if false;
      allow create: if isActiveResident()
        && uid() == userId
        && request.resource.data.secret is string
        && request.resource.data.secret ==
           get(/databases/$(database)/documents/config/admin).data.secret;
      allow update: if false;
      allow delete: if isSignedIn() && uid() == userId;
    }

    // ---------------------------------------------------------------- issues

    match /issues/{issueId} {
      allow read: if isActiveResident();

      allow create: if isActiveResident()
        && request.resource.data.authorId == uid()
        && request.resource.data.statusId == 'OPEN'
        && request.resource.data.get('upvotes', 0) == 0
        && request.resource.data.get('downvotes', 0) == 0
        && request.resource.data.get('score', 0) == 0
        && request.resource.data.get('commentCount', 0) == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.get('description', '').size() <= 4000
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && imageWithin('thumbnail', 20000);

      // Any resident may nudge the vote tally by one, because casting a vote is
      // a two-document transaction and this is its second half. The invariant
      // score == upvotes - downvotes is enforced here so the sort order can
      // never be driven out of step with the counts.
      function isVoteTallyWrite() {
        return isActiveResident()
          && touchesOnly(['upvotes', 'downvotes', 'score'])
          && movedByOne('upvotes')
          && movedByOne('downvotes')
          && request.resource.data.score ==
             request.resource.data.upvotes - request.resource.data.downvotes;
      }

      // Likewise for the comment total, the second half of posting a comment.
      function isCommentCountWrite() {
        return isActiveResident()
          && touchesOnly(['commentCount'])
          && movedByOne('commentCount');
      }

      /**
       * The author or a moderator editing the report itself.
       *
       * A denylist, which is worth being explicit about because it means every
       * field added to this schema is editable here unless it is named. The
       * municipal record was added and was immediately writable by any author
       * through this branch, which quietly contradicted the moderator-only rule
       * written directly beneath it — so it is named. Tallies, authorship and
       * the filing date were always named for the same reason.
       */
      function isContentEdit() {
        return isActiveResident()
          && (resource.data.authorId == uid() || isModerator())
          && !changed([
            'upvotes', 'downvotes', 'score', 'commentCount', 'authorId', 'createdAt',
            'reportedToCouncilAt', 'councilReference'
          ]);
      }

      /**
       * A resident claiming a report, or letting one go.
       *
       * This is the one write on an issue that an ordinary resident may make
       * to somebody else's document, so it is fenced tightly: the diff may
       * touch nothing but the three assignment fields, and the name written
       * must be the caller's own. Taking requires the report to be unclaimed;
       * releasing requires you to be the one holding it, or a moderator.
       *
       * A claim is not an assignment handed down by anyone: the uid written
       * must be the caller's own, so nobody can put a neighbour *account* on a
       * job. The display name beside it is bounded but not verified against
       * the profile — exactly as `authorName` and `assigneeName` are treated
       * everywhere else in this schema, because a resident's display name is
       * not a stable key and reconstructing it in a rule would be guesswork.
       * The uid is the identity; the name is a label.
       */
      function isTakeOrRelease() {
        return isActiveResident()
          && touchesOnly(['assigneeId', 'assigneeName', 'assignedAt', 'updatedAt'])
          && (
            // Taking an unclaimed report, in your own name.
            //
            // `get(field, default)` rather than `resource.data.field`: every
            // report filed before this feature existed has no assignment keys
            // at all, and reading a missing property is an evaluation error
            // that denies the whole write. Written the direct way, this rule
            // worked on new reports and refused every old one — and the test
            // suite could not see it, because every fixture seeded the fields.
            (resource.data.get('assigneeId', '') == ''
              && request.resource.data.assigneeId == uid()
              && request.resource.data.assigneeName is string
              && request.resource.data.assigneeName.size() > 0
              && request.resource.data.assigneeName.size() <= 80
              // A finished report is not available to take on.
              && resource.data.get('statusId', 'OPEN') in ['OPEN', 'ACKNOWLEDGED', 'IN_PROGRESS'])
            // Or giving back one you hold — moderators may unstick any.
            // The name goes with the claim; leaving it behind would show a
            // resident's name against a job nobody holds.
            || (request.resource.data.assigneeId == ''
              && request.resource.data.assigneeName == ''
              && (resource.data.get('assigneeId', '') == uid() || isModerator()))
          );
      }

      /**
       * Recording that a report has been handed to the municipality.
       *
       * A moderator's act, and the one rule here that is about something which
       * happened outside the app entirely. Anybody may forward a report — that
       * is their own e-mail over their own name and this app has no part in it
       * — but "this is now with the δήμος, protocol 1234" is read by the whole
       * village and is why nobody sends it again. A claim anybody could make is
       * a claim nobody can rely on.
       */
      function isCouncilRecord() {
        return isModerator()
          && touchesOnly(['reportedToCouncilAt', 'councilReference', 'updatedAt'])
          && (request.resource.data.get('councilReference', '') is string)
          && (request.resource.data.get('councilReference', '').size() <= 60);
      }

      allow update: if imageWithin('thumbnail', 20000)
        && (
          isContentEdit() || isVoteTallyWrite() || isCommentCountWrite()
            || isTakeOrRelease() || isCouncilRecord()
        );

      allow delete: if isActiveResident()
        && (resource.data.authorId == uid() || isModerator());

      // ----------------------------------------------------------- photos

      /**
       * A report's full-size pictures, one per document.
       *
       * They are kept out of the report itself because the map reads every
       * report in the village on every launch, and half a megabyte apiece
       * would make that read enormous. Opening a report is what fetches these.
       */
      match /photos/{photoId} {
        allow read: if isActiveResident();
        allow create: if isActiveResident()
          && request.resource.data.authorId == uid()
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 600000;
        // A picture is replaced by deleting it and adding another, so that an
        // edit cannot quietly swap the evidence under a report.
        allow update: if false;
        allow delete: if isActiveResident()
          && (resource.data.authorId == uid()
              || get(/databases/$(database)/documents/issues/$(issueId)).data.authorId == uid()
              || isModerator());
      }

      // ------------------------------------------------------------ votes

      match /votes/{voterId} {
        allow read: if isActiveResident();
        // One document per resident, at a path keyed by their own uid: the
        // structure itself makes double-voting impossible.
        allow create, update: if isActiveResident()
          && uid() == voterId
          && request.resource.data.userId == voterId
          && request.resource.data.value in [1, -1];
        // Deletable by the voter, and by whoever is allowed to delete the
        // parent report, since the client now sweeps the subcollections itself.
        allow delete: if isActiveResident()
          && (uid() == voterId
              || get(/databases/$(database)/documents/issues/$(issueId)).data.authorId == uid()
              || isModerator());
      }

      // --------------------------------------------------------- comments

      match /comments/{commentId} {
        allow read: if isActiveResident();
        allow create: if isActiveResident()
          && request.resource.data.authorId == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        // Comments are not editable: an edited comment under a reply thread
        // changes what other people appear to have responded to.
        allow update: if false;
        allow delete: if isActiveResident()
          && (resource.data.authorId == uid()
              || get(/databases/$(database)/documents/issues/$(issueId)).data.authorId == uid()
              || isModerator());
      }
    }

    // --------------------------------------------------------- announcements

    match /announcements/{announcementId} {
      allow read: if isActiveResident();
      allow create, update: if isAdmin() && imageWithin('image', 150000);
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------------- events

    /**
     * The village calendar at `events/{id}`.
     *
     * Any resident may add one, which is deliberate: the point of the calendar
     * is that the liturgy, the πανηγύρι and the Saturday somebody decided to
     * clear the forest track all reach the whole village, and routing that
     * through an administrator would mean it reaches whoever remembers to ask.
     * Announcements stay admin-only; those speak *for* the village, and these
     * only speak *to* it.
     *
     * The interesting rule is attendance. Saying "I am coming" has to be
     * possible on somebody else's event, so residents can write to documents
     * they do not own — and the only thing standing between that and one
     * resident signing up their neighbours is [isAttendanceToggle].
     */
    match /events/{eventId} {

      /**
       * Everything about an event except who is coming.
       *
       * The bounds are not decoration. Without them an ordinary resident could
       * write an event dated 2099, a `kind` of anything, an `allDay` of "yes",
       * a forty-thousand-character author name and arbitrary extra fields —
       * all of which were possible and all of which were verified against the
       * emulator before this was written. The date window matters most: the
       * calendar shows the next sixty by start time, so a handful of documents
       * dated far in the future is enough to fill everyone's screen, and the
       * card prints no year, so "Friday 31 December" reads as this year's.
       */
      function validContent() {
        return request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 90
          && request.resource.data.get('description', '').size() <= 1200
          && request.resource.data.get('place', '').size() <= 80
          && request.resource.data.get('authorName', '') is string
          && request.resource.data.get('authorName', '').size() <= 80
          && request.resource.data.get('kind', 'OTHER') is string
          && request.resource.data.get('kind', 'OTHER').size() <= 20
          && request.resource.data.get('allDay', false) is bool
          && (request.resource.data.get('endAt', null) == null
              || request.resource.data.endAt is timestamp)
          && request.resource.data.startAt is timestamp
          // A year back, two years forward. Long enough for next summer's
          // πανηγύρι, short enough that the list cannot be filled with 2099.
          && request.resource.data.startAt > request.time - duration.value(365, 'd')
          && request.resource.data.startAt < request.time + duration.value(730, 'd')
          && request.resource.data.keys().hasOnly([
            'title', 'description', 'place', 'kind', 'startAt', 'endAt',
            'allDay', 'attendees', 'authorId', 'authorName',
            'createdAt', 'updatedAt'
          ]);
      }


      /**
       * The one write a resident may make to an event that is not theirs.
       *
       * Two conditions do the work. The outer `hasOnly` confines the write to
       * the attendee map and the timestamp, so this cannot be a way to edit
       * somebody else's title. The inner one confines the *map* diff to a
       * single key which must be the caller's own uid — which is exactly the
       * check that two parallel arrays of ids and names could not support, and
       * the reason the attendees are stored as a map.
       *
       * `get('attendees', {})` rather than `resource.data.attendees`, because
       * reading a field that is not there is an evaluation error and would deny
       * the write outright. Any event created before this field existed would
       * otherwise be one nobody could ever join.
       */
      function isAttendanceToggle() {
        return touchesOnly(['attendees', 'updatedAt'])
          && request.resource.data.get('attendees', {})
              .diff(resource.data.get('attendees', {}))
              .affectedKeys().hasOnly([uid()])
          && (
            !(uid() in request.resource.data.get('attendees', {}))
            || (request.resource.data.attendees[uid()] is string
                && request.resource.data.attendees[uid()].size() > 0
                && request.resource.data.attendees[uid()].size() <= 80)
          );
      }

      allow read: if isActiveResident();

      // A new event credits its actual author and starts with exactly its
      // organiser attending — seeding it with a crowd would fake a turnout.
      allow create: if isActiveResident()
        && validContent()
        && request.resource.data.authorId == uid()
        && request.resource.data.authorName is string
        && request.resource.data.get('attendees', {}).keys().hasOnly([uid()])
        && (!(uid() in request.resource.data.get('attendees', {}))
            || (request.resource.data.attendees[uid()] is string
                && request.resource.data.attendees[uid()].size() > 0
                && request.resource.data.attendees[uid()].size() <= 80));

      /**
       * Editing an event never touches who is coming.
       *
       * `!changed(['attendees'])` is the whole point of this branch and it was
       * missing. Without it the map was pointless: the author could not add a
       * neighbour one key at a time, but they could rewrite the entire map in a
       * single ordinary edit — verified against the emulator — and put six
       * names against a Saturday nobody had agreed to. Attendance moves only
       * through [isAttendanceToggle], for everyone, including moderators.
       */
      allow update: if isActiveResident() && (
        isAttendanceToggle()
        || (
          (uid() == resource.data.authorId || isModerator())
          && validContent()
          && !changed(['authorId', 'createdAt', 'attendees'])
        )
      );

      allow delete: if isActiveResident()
        && (uid() == resource.data.authorId || isModerator());
    }

    // --------------------------------------------------------------- alerts

    /**
     * What is wrong in the village right now, at `alerts/{id}`.
     *
     * Any resident may raise one, and that is not a loose end — it is the
     * feature. A fire on the hill at four in the morning is not something to
     * route through a moderator, and a power cut is only worth reporting if the
     * person sitting in the dark can report it.
     *
     * What the rules police is the same thing they police on the calendar:
     * nobody may speak for anybody else. An alert credits its author, and the
     * "I have it too" count may only ever be moved by one person, for
     * themselves — because the count is the entire content of an outage report,
     * and a count one person can inflate is a count nobody should act on.
     */
    match /alerts/{alertId} {

      function validAlert() {
        return request.resource.data.kind is string
          && request.resource.data.kind.size() <= 20
          && request.resource.data.get('note', '') is string
          && request.resource.data.get('note', '').size() <= 240
          && request.resource.data.get('placeLabel', '') is string
          && request.resource.data.get('placeLabel', '').size() <= 80
          && request.resource.data.raisedByName is string
          && request.resource.data.raisedByName.size() > 0
          && request.resource.data.raisedByName.size() <= 80
          // Now, give or take a clock. Unbounded, this was the whole feature's
          // undoing: an alert dated 2099 is never stale, because isActive()
          // measures age and a future date has a negative one. Forty of them
          // fill the page the client asks for, sort to the top of it, and a
          // real fire raised afterwards is returned to nobody's phone. Only an
          // administrator can delete an alert, so it would have stayed there.
          && request.resource.data.raisedAt is timestamp
          && request.resource.data.raisedAt < request.time + duration.value(1, 'h')
          && request.resource.data.raisedAt > request.time - duration.value(1, 'd')
          && request.resource.data.get('confirmedNames', []).size() ==
             request.resource.data.get('confirmedBy', []).size()
          && (request.resource.data.get('lat', null) == null
              || (request.resource.data.lat is number
                  && request.resource.data.lat >= -90 && request.resource.data.lat <= 90))
          && (request.resource.data.get('lng', null) == null
              || (request.resource.data.lng is number
                  && request.resource.data.lng >= -180 && request.resource.data.lng <= 180))
          && request.resource.data.keys().hasOnly([
            'kind', 'note', 'lat', 'lng', 'placeLabel',
            'raisedById', 'raisedByName', 'raisedAt',
            'confirmedBy', 'confirmedNames',
            'resolvedAt', 'resolvedById', 'updatedAt'
          ]);
      }

      /**
       * "I have it too", and nothing else.
       *
       * The same shape as the street-name confirmation: the write is confined
       * to the two arrays and the timestamp, and the difference between the old
       * and new id sets may only ever be the caller's own uid, in either
       * direction. Without the set difference on *both* sides a resident could
       * add themselves while quietly removing four neighbours.
       */
      function isConfirmationToggle() {
        return touchesOnly(['confirmedBy', 'confirmedNames', 'updatedAt'])
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.raisedById == resource.data.raisedById
          // The id list is set-checked below; the name list beside it was not
          // checked at all, so it could be replaced wholesale or grown to a
          // quarter of a megabyte on a document all forty-six phones fetch on
          // every launch.
          //
          // The names may move no further than the ids did. `<=` rather than
          // `==` on purpose: display names are "Γιώργος Π." and two of those
          // in a village of forty-six is not far-fetched, so adding a second
          // person of the same name adds an id and no new name, and that must
          // still be allowed. What it forbids is the case that has no
          // innocent reading — the ids standing still while the names change.
          && request.resource.data.get('confirmedBy', []).size() <= 60
          && request.resource.data.get('confirmedNames', []).size() ==
             request.resource.data.get('confirmedBy', []).size()
          && request.resource.data.get('confirmedNames', []).toSet()
               .difference(resource.data.get('confirmedNames', []).toSet()).size() <=
             request.resource.data.get('confirmedBy', []).toSet()
               .difference(resource.data.get('confirmedBy', []).toSet()).size()
          && resource.data.get('confirmedNames', []).toSet()
               .difference(request.resource.data.get('confirmedNames', []).toSet()).size() <=
             resource.data.get('confirmedBy', []).toSet()
               .difference(request.resource.data.get('confirmedBy', []).toSet()).size()
          && request.resource.data.get('confirmedBy', []).toSet()
              .difference(resource.data.get('confirmedBy', []).toSet())
              in [[].toSet(), [uid()].toSet()]
          && resource.data.get('confirmedBy', []).toSet()
              .difference(request.resource.data.get('confirmedBy', []).toSet())
              in [[].toSet(), [uid()].toSet()];
      }

      /** Marking it over touches only that, and only for those entitled to. */
      function isResolution() {
        return touchesOnly(['resolvedAt', 'resolvedById', 'updatedAt'])
          // A string here parses to nothing on the client and drops the alert
          // from every phone's list — a quieter way to bury a report than
          // resolving it, and one nobody would see happen.
          && request.resource.data.resolvedAt is timestamp
          && request.resource.data.resolvedById == uid()
          && (uid() == resource.data.raisedById || isModerator());
      }

      allow read: if isActiveResident();

      allow create: if isActiveResident()
        && validAlert()
        && request.resource.data.raisedById == uid()
        && request.resource.data.get('confirmedBy', []) == [uid()]
        && request.resource.data.get('resolvedAt', null) == null;

      allow update: if isActiveResident() && (isConfirmationToggle() || isResolution());

      // Never deleted, only resolved. An alert is a record of something that
      // happened, and the village may want to know afterwards how long the
      // water was off.
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------- contacts

    /**
     * Telephone numbers the village keeps for itself, at `contacts/{id}`.
     *
     * Administrators only. The emergency numbers a resident actually needs in
     * a hurry — 112, 199, 166, 100 and the electricity fault line — are
     * compiled into the app and are not here at all, precisely so that they
     * render with no account, no network and no rule evaluation between the
     * resident and the number. What lives here is the local half: the surgery
     * at Vilia, the municipality's works desk, whoever holds the key to the
     * water tank. Those are worth being careful with, because a wrong number
     * for a doctor is worse than no number at all.
     */
    match /contacts/{contactId} {
      function validContact() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.number is string
          && request.resource.data.number.size() > 2
          && request.resource.data.number.size() <= 24
          && request.resource.data.get('note', '').size() <= 120;
      }

      allow read: if isActiveResident();
      allow create, update: if isAdmin() && validContact();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------- street names

    /**
     * The village naming its own streets, keyed by OpenStreetMap way id.
     *
     * No public dataset names these streets — OSM names one way in the whole
     * settlement — so the residents supply them. That means an ordinary
     * resident can write here, which is unusual for this app, and the rules
     * carry the whole weight of keeping it honest.
     *
     * Three things are policed. A proposal must credit its actual author, so
     * nobody can put words in a neighbour's mouth. Confirming is a write that
     * may touch nothing but `confirmedBy` and `updatedAt`, and may only add or
     * remove the confirmer's own uid — one resident cannot manufacture
     * agreement out of other people's accounts. And rewriting an existing name
     * is limited to the person who proposed it or a moderator, because a name
     * with confirmations behind it is a small piece of shared knowledge, not a
     * free-text field.
     */
    match /streetNames/{wayId} {
      function namedByCaller() {
        return request.resource.data.proposedById == uid()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          // A fresh proposal starts with exactly one confirmation: its author.
          // Seeding it with a crowd would fake a consensus that never happened.
          && request.resource.data.confirmedBy == [uid()]
          && request.resource.data.get('proposedByName', '').size() <= 80
          // Named keys only. Without this a resident could hang a quarter of a
          // megabyte off a street name, and the whole collection is fetched
          // unpaged every time anybody opens the map.
          && request.resource.data.keys().hasOnly([
            'wayId', 'name', 'proposedById', 'proposedByName',
            'confirmedBy', 'createdAt', 'updatedAt'
          ]);
      }

      /**
       * A confirmation, which is the only write a resident may make to someone
       * else's proposal.
       *
       * `hasOnly` on the affected keys is what keeps this from being a way to
       * edit the name: the diff has to be confined to the two fields, and the
       * name that comes back has to be the name that was there.
       */
      function isConfirmationToggle() {
        return touchesOnly(['confirmedBy', 'updatedAt'])
          && request.resource.data.name == resource.data.name
          && request.resource.data.proposedById == resource.data.proposedById
          && request.resource.data.confirmedBy.size() <= 60
          && (
            // Adding themselves, or removing themselves. Nothing else moves.
            request.resource.data.confirmedBy.toSet()
              .difference(resource.data.confirmedBy.toSet()) in [[].toSet(), [uid()].toSet()]
            && resource.data.confirmedBy.toSet()
              .difference(request.resource.data.confirmedBy.toSet()) in [[].toSet(), [uid()].toSet()]
          );
      }

      allow read: if isActiveResident();
      allow create: if isActiveResident() && namedByCaller();
      allow update: if isActiveResident() && (
        isConfirmationToggle()
        || ((uid() == resource.data.proposedById || isModerator()) && namedByCaller())
      );
      // Only a moderator removes a name outright. A resident who thinks one is
      // wrong proposes a correction instead, which keeps the history of who
      // said what rather than leaving an unexplained blank.
      allow delete: if isModerator();
    }

    // ----------------------------------------------------------------- chats

    match /chats/{chatId} {
      function isMember() {
        return isSignedIn() && uid() in resource.data.memberIds;
      }

      /**
       * A direct conversation's id is the two uids sorted and joined, so the
       * id alone says who is in it. That matters for the case below, where
       * there is no document yet to ask.
       */
      function isMyDirectChatId() {
        return uid() in chatId.split('_');
      }

      // Reading a chat that does not exist has to be answerable, because that
      // is exactly how a direct conversation starts: the app derives the
      // deterministic id and reads it to decide whether to create it. On a
      // missing document `resource` is null, so a rule that reaches into
      // `resource.data` does not evaluate to false — it errors, and the read is
      // denied. That denial made it impossible to ever open a direct message.
      //
      // Membership therefore comes from the id when the document is absent,
      // and from the document itself when it is present. A group chat has a
      // random id and so cannot be probed this way at all.
      allow get: if isSignedIn() && (
        resource == null ? isMyDirectChatId() : uid() in resource.data.memberIds
      );

      // Queries only ever return documents that exist, so listing keeps the
      // straightforward membership test.
      allow list: if isMember();

      // You may only create a conversation you are part of.
      allow create: if isActiveResident()
        && uid() in request.resource.data.memberIds
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 100;

      // Members maintain the preview line and the unread badges themselves,
      // since there is no function to do it. Who started the conversation and
      // when stay immutable.
      allow update: if isMember() && !changed(['createdById', 'createdAt']);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        function inChat() {
          return isSignedIn()
            && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        }

        allow read: if inChat();
        allow create: if inChat()
          && request.resource.data.senderId == uid()
          && request.resource.data.get('text', '').size() <= 4000
          && imageWithin('image', 150000);
        allow update: if false;
        allow delete: if inChat() && resource.data.senderId == uid();
      }
    }
  }
}
