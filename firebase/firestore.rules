rules_version = '2';

// Security model, in one line: this app runs entirely on the Spark (free) plan,
// so there is no server to own the counters — clients maintain them, and these
// rules are the only thing constraining what they may write.
//
// The consequences are deliberate and worth stating:
//
//   * A vote or comment tally can only move by one per write, and `score` must
//     stay equal to `upvotes - downvotes`. Someone running a modified client
//     could still nudge a counter without casting a real vote — rules cannot
//     see another document's pending write inside a transaction — but they
//     cannot jump a report to a thousand upvotes, and they cannot touch anyone
//     else's content. For a village of neighbours that is the right trade.
//   * Roles live on the user document rather than in a custom claim, because
//     setting a claim needs the Admin SDK. Only an administrator may write the
//     `role` and `disabled` fields, and never on their own document.
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Repeated get() calls to the same path inside one evaluation are cached,
    // so leaning on this helper does not multiply the read cost.
    function profile() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(uid()));
    }

    function isActiveResident() {
      return hasProfile() && profile().get('disabled', false) == false;
    }

    function role() {
      return hasProfile() ? profile().get('role', 'USER') : 'USER';
    }

    function isAdmin() {
      return isActiveResident() && role() == 'ADMIN';
    }

    function isModerator() {
      return isActiveResident() && (role() == 'ADMIN' || role() == 'MODERATOR');
    }

    /** Fields present in the incoming write that differ from the stored document. */
    function changed(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function touchesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    /**
     * Images live inside documents rather than in Cloud Storage, which needs a
     * billing account this village does not have. Firestore hard-caps a
     * document at 1 MiB, so every image field is bounded here as well as in the
     * app: a client is not the right place for the only copy of a limit.
     */
    function imageWithin(field, maxBytes) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is bytes
            && request.resource.data[field].size() <= maxBytes);
    }

    /** A counter that moved by at most one in either direction, and never below zero. */
    function movedByOne(field) {
      return request.resource.data[field] is int
        && request.resource.data[field] >= 0
        && request.resource.data[field] - resource.data[field] >= -1
        && request.resource.data[field] - resource.data[field] <= 1;
    }

    // ----------------------------------------------------------------- users

    match /users/{userId} {
      allow read: if isActiveResident() || uid() == userId;

      // Self-registration only, and never with a role of your own choosing.
      allow create: if isSignedIn()
        && uid() == userId
        && request.resource.data.get('role', 'USER') == 'USER'
        && request.resource.data.get('disabled', false) == false
        && imageWithin('avatar', 30000);

      /**
       * Taking administrator rights by proving the passphrase.
       *
       * Narrow on purpose: only your own document, only the role field moving
       * to ADMIN, and only while an accepted claim exists — which it can only
       * do if the passphrase matched. `disabled` is untouchable here, so a
       * suspended resident cannot let themselves back in.
       */
      function isSelfElevation() {
        return isActiveResident()
          && uid() == userId
          && touchesOnly(['role', 'updatedAt'])
          && request.resource.data.role == 'ADMIN'
          && exists(/databases/$(database)/documents/adminClaims/$(uid()));
      }

      // Residents edit their own contact details but never their own standing.
      // Administrators may edit anyone — including role and suspension — except
      // themselves, so the last admin cannot lock the village out by accident.
      allow update: if isSignedIn()
        && imageWithin('avatar', 30000)
        && (
          (uid() == userId && !changed(['role', 'disabled', 'createdAt']))
          || (isAdmin() && uid() != userId && !changed(['createdAt']))
          || isSelfElevation()
        );

      // Residents may close their own account; administrators may remove a
      // resident. Neither can delete the underlying login — that needs the
      // Admin SDK — so the app deletes its own data and says so plainly.
      allow delete: if isSignedIn() && (uid() == userId || (isAdmin() && uid() != userId));

      // ---------------------------------------------------- notification inbox

      /**
       * One resident's notices, written *by other residents*.
       *
       * Sending a real push needs a server credential, which needs the paid
       * plan, so the acting client addresses the notice itself: comment on your
       * report and my phone writes a document here, under your uid, and your
       * phone turns it into a notification.
       *
       * That necessarily means any resident may write into anyone's inbox —
       * there is no way to notify someone without writing something they can
       * see. What is constrained is everything else: the notice must be
       * honestly attributed, it cannot arrive pre-read, and it is capped so an
       * inbox cannot be used to store bulk data at someone else's expense.
       * Reading and clearing stay private to the owner.
       */
      match /notifications/{noticeId} {
        allow read, update, delete: if isSignedIn() && uid() == userId;

        allow create: if isActiveResident()
          && request.resource.data.actorId == uid()
          && request.resource.data.get('seen', false) == false
          && request.resource.data.get('title', '').size() <= 200
          && request.resource.data.get('body', '').size() <= 500
          && request.resource.data.get('bodyArg', '').size() <= 500
          && request.resource.data.get('deepLink', '').size() <= 300;
      }
    }

    // ------------------------------------------------- administrator elevation

    /**
     * The village's admin passphrase, at `config/admin` with field `secret`.
     *
     * No client may read it. Rules may: a `get()` inside a rule is evaluated on
     * the server and is not itself subject to these rules, which is what makes
     * a secret usable without ever shipping it to a phone.
     *
     * Set it from the Firebase console. Until it exists, every elevation
     * attempt fails — which is the correct default for a village that has not
     * chosen a passphrase.
     */
    match /config/{document} {
      allow read, write: if false;
    }

    /**
     * Proof that somebody typed the passphrase.
     *
     * The write succeeds only if what they typed matches the stored secret, so
     * a wrong guess is rejected here and learns nothing: a wrong passphrase and
     * an unconfigured village fail identically. Nobody may read this collection
     * — including its own author — so the secret cannot be recovered from it.
     *
     * The app deletes the claim as soon as it has been used. Deletion is
     * allowed so it does not need administrator rights to clean up after
     * itself.
     */
    match /adminClaims/{userId} {
      allow read: if false;
      allow create: if isActiveResident()
        && uid() == userId
        && request.resource.data.secret is string
        && request.resource.data.secret ==
           get(/databases/$(database)/documents/config/admin).data.secret;
      allow update: if false;
      allow delete: if isSignedIn() && uid() == userId;
    }

    // ---------------------------------------------------------------- issues

    match /issues/{issueId} {
      allow read: if isActiveResident();

      allow create: if isActiveResident()
        && request.resource.data.authorId == uid()
        && request.resource.data.statusId == 'OPEN'
        && request.resource.data.get('upvotes', 0) == 0
        && request.resource.data.get('downvotes', 0) == 0
        && request.resource.data.get('score', 0) == 0
        && request.resource.data.get('commentCount', 0) == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.get('description', '').size() <= 4000
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && imageWithin('thumbnail', 20000);

      // Any resident may nudge the vote tally by one, because casting a vote is
      // a two-document transaction and this is its second half. The invariant
      // score == upvotes - downvotes is enforced here so the sort order can
      // never be driven out of step with the counts.
      function isVoteTallyWrite() {
        return isActiveResident()
          && touchesOnly(['upvotes', 'downvotes', 'score'])
          && movedByOne('upvotes')
          && movedByOne('downvotes')
          && request.resource.data.score ==
             request.resource.data.upvotes - request.resource.data.downvotes;
      }

      // Likewise for the comment total, the second half of posting a comment.
      function isCommentCountWrite() {
        return isActiveResident()
          && touchesOnly(['commentCount'])
          && movedByOne('commentCount');
      }

      // The author or a moderator may edit the report itself, but never its
      // tallies, its authorship, or when it was filed.
      function isContentEdit() {
        return isActiveResident()
          && (resource.data.authorId == uid() || isModerator())
          && !changed(['upvotes', 'downvotes', 'score', 'commentCount', 'authorId', 'createdAt']);
      }

      allow update: if imageWithin('thumbnail', 20000)
        && (isContentEdit() || isVoteTallyWrite() || isCommentCountWrite());

      allow delete: if isActiveResident()
        && (resource.data.authorId == uid() || isModerator());

      // ----------------------------------------------------------- photos

      /**
       * A report's full-size pictures, one per document.
       *
       * They are kept out of the report itself because the map reads every
       * report in the village on every launch, and half a megabyte apiece
       * would make that read enormous. Opening a report is what fetches these.
       */
      match /photos/{photoId} {
        allow read: if isActiveResident();
        allow create: if isActiveResident()
          && request.resource.data.authorId == uid()
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 600000;
        // A picture is replaced by deleting it and adding another, so that an
        // edit cannot quietly swap the evidence under a report.
        allow update: if false;
        allow delete: if isActiveResident()
          && (resource.data.authorId == uid()
              || get(/databases/$(database)/documents/issues/$(issueId)).data.authorId == uid()
              || isModerator());
      }

      // ------------------------------------------------------------ votes

      match /votes/{voterId} {
        allow read: if isActiveResident();
        // One document per resident, at a path keyed by their own uid: the
        // structure itself makes double-voting impossible.
        allow create, update: if isActiveResident()
          && uid() == voterId
          && request.resource.data.userId == voterId
          && request.resource.data.value in [1, -1];
        // Deletable by the voter, and by whoever is allowed to delete the
        // parent report, since the client now sweeps the subcollections itself.
        allow delete: if isActiveResident()
          && (uid() == voterId
              || get(/databases/$(database)/documents/issues/$(issueId)).data.authorId == uid()
              || isModerator());
      }

      // --------------------------------------------------------- comments

      match /comments/{commentId} {
        allow read: if isActiveResident();
        allow create: if isActiveResident()
          && request.resource.data.authorId == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        // Comments are not editable: an edited comment under a reply thread
        // changes what other people appear to have responded to.
        allow update: if false;
        allow delete: if isActiveResident()
          && (resource.data.authorId == uid()
              || get(/databases/$(database)/documents/issues/$(issueId)).data.authorId == uid()
              || isModerator());
      }
    }

    // --------------------------------------------------------- announcements

    match /announcements/{announcementId} {
      allow read: if isActiveResident();
      allow create, update: if isAdmin() && imageWithin('image', 150000);
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------------- chats

    match /chats/{chatId} {
      function isMember() {
        return isSignedIn() && uid() in resource.data.memberIds;
      }

      /**
       * A direct conversation's id is the two uids sorted and joined, so the
       * id alone says who is in it. That matters for the case below, where
       * there is no document yet to ask.
       */
      function isMyDirectChatId() {
        return uid() in chatId.split('_');
      }

      // Reading a chat that does not exist has to be answerable, because that
      // is exactly how a direct conversation starts: the app derives the
      // deterministic id and reads it to decide whether to create it. On a
      // missing document `resource` is null, so a rule that reaches into
      // `resource.data` does not evaluate to false — it errors, and the read is
      // denied. That denial made it impossible to ever open a direct message.
      //
      // Membership therefore comes from the id when the document is absent,
      // and from the document itself when it is present. A group chat has a
      // random id and so cannot be probed this way at all.
      allow get: if isSignedIn() && (
        resource == null ? isMyDirectChatId() : uid() in resource.data.memberIds
      );

      // Queries only ever return documents that exist, so listing keeps the
      // straightforward membership test.
      allow list: if isMember();

      // You may only create a conversation you are part of.
      allow create: if isActiveResident()
        && uid() in request.resource.data.memberIds
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 100;

      // Members maintain the preview line and the unread badges themselves,
      // since there is no function to do it. Who started the conversation and
      // when stay immutable.
      allow update: if isMember() && !changed(['createdById', 'createdAt']);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        function inChat() {
          return isSignedIn()
            && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        }

        allow read: if inChat();
        allow create: if inChat()
          && request.resource.data.senderId == uid()
          && request.resource.data.get('text', '').size() <= 4000
          && imageWithin('image', 150000);
        allow update: if false;
        allow delete: if inChat() && resource.data.senderId == uid();
      }
    }
  }
}
