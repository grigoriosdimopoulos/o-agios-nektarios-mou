# Gradle / Android
.gradle/
build/
local.properties
*.apk
# ...except the one build handed to the tester; see dist/README.md.
!dist/*.apk
*.aab
*.jks
*.keystore
# ...except the shared debug key, which is deliberately committed so every
# build installs as an update and matches one Firebase fingerprint. It signs
# nothing that ships; a release keystore must never be committed.
!keystore/debug.keystore
# The upload key's passwords. The .jks itself is already caught by *.jks
# above, but this sits beside it and holds the passphrase in plain text.
keystore/upload.properties
captures/
.cxx/
# The Kotlin daemon writes a liveness marker per build under .kotlin/sessions
# and deletes it again on exit, so a tracked one shows up as a change after
# every single compile. Build scratch, never source.
.kotlin/

# Firebase config — project-specific and contains client identifiers.
# Every developer supplies their own; see docs/SETUP.md.
google-services.json
!app/google-services.json.example
.firebase/
firebase-debug.log
*-debug.log

# Cloud Functions
firebase/functions/node_modules/
firebase/functions/lib/
node_modules/

# IDE
.idea/
*.iml
.DS_Store
firebase/node_modules/
